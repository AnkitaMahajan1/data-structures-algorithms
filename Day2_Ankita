#1. Best Time to Buy and Sell Stock
class Solution:
    def maxProfit(self, prices: list[int]) -> int:
        left = 0
        maxi = 0
        for right in range(1, len(prices)):
            if prices[right] - prices[left] < 0:
                left = right
            maxi = max(prices[right] - prices[left], maxi)
        return maxi

obj = Solution()
print(obj.maxProfit([2,1,2,1,0,1,2]))

#2. Move Zeroes
class Solution:
    def moveZeroes(self, nums: list[int]) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        left = 0
        for right in range(len(nums)):
            if nums[right] != 0:
                temp = nums[left]
                nums[left] = nums[right]
                nums[right] = temp
                left += 1

#3. Remove Duplicates from Sorted Array
class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        left = 1
        for right in range(1, len(nums)):
            if nums[right] != nums[right-1]:
                nums[left] = nums[right]
                left += 1
        return left


##############################################System Design###############################################################

REST resources: URLs identify resources; HTTP methods express intended operations.
HTTP methods: GET reads, POST creates or triggers operations, PUT replaces, PATCH partially updates, DELETE removes.
Status codes: 200 success, 201 created, 400 invalid request, 401 authentication failure, 404 not found, 429 rate limit, 500 server error.
Pagination: Offset is simple; cursors are generally better for changing feeds and large datasets.
Versioning: /v1/ and /v2/ allow breaking changes to be introduced without immediately breaking existing clients.
